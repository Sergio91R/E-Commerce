{
  "name": "@examen-ecommerce/backend",
  "version": "1.0.0",
  "description": "Backend del checkout con motor de descuentos acumulativos",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "build:shared": "tsc -p ../../packages/shared-types/tsconfig.json",
    "dev": "npm run build:shared && ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/server.ts",
    "build": "npm run build:shared && tsc -p tsconfig.json",
    "start": "node -r tsconfig-paths/register dist/server.js",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "lint": "eslint \"src/**/*.ts\""
  },
  "dependencies": {
    "express": "^4.19.2",
    "cors": "^2.8.5",
    "uuid": "^9.0.1",
    "tsconfig-paths": "^4.2.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.11.30",
    "@types/jest": "^29.5.12",
    "@types/supertest": "^6.0.2",
    "typescript": "^5.4.5",
    "ts-node-dev": "^2.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.2",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0"
  }
}
